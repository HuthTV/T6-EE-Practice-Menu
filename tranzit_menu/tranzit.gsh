/*##############################################################################
                              TranZit shared #defines
##############################################################################*/
// Inlined by every tranzit_menu file with #inline scripts\zm\tranzit_menu\tranzit

/*##############################################################################
                              Denizen teleports
##############################################################################*/
// Teleports the Denizen Teleports menu sets, in order. Later ones are random.
#define DENIZEN_TELEPORTS  20

/*##############################################################################
                              Avogadro (Maxis side)
##############################################################################*/
// Values of the "avogadro_return" setting.
#define AVO_RETURN_VANILLA  0     // 2 to 4 rounds, next round after an idle exit
#define AVO_RETURN_NEXT     1     // The round after it left
#define AVO_RETURN_NOW      2     // At once, in the storm's region

/*##############################################################################
                              Timescale used while a mode sets up
##############################################################################*/
#define SETUP_TIMESCALE  10
